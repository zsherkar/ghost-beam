{
  "$defs": {
    "BeamTruth": {
      "properties": {
        "beam_quality": {
          "title": "Beam Quality",
          "type": "number"
        },
        "beam_size_x": {
          "title": "Beam Size X",
          "type": "number"
        },
        "beam_size_y": {
          "title": "Beam Size Y",
          "type": "number"
        },
        "beam_loss": {
          "title": "Beam Loss",
          "type": "number"
        },
        "emittance_proxy": {
          "title": "Emittance Proxy",
          "type": "number"
        }
      },
      "required": [
        "beam_quality",
        "beam_size_x",
        "beam_size_y",
        "beam_loss",
        "emittance_proxy"
      ],
      "title": "BeamTruth",
      "type": "object"
    },
    "ElogHit": {
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "recommended_action": {
          "title": "Recommended Action",
          "type": "string"
        },
        "similarity": {
          "title": "Similarity",
          "type": "number"
        },
        "risk_tags": {
          "items": {
            "type": "string"
          },
          "title": "Risk Tags",
          "type": "array"
        }
      },
      "required": [
        "date",
        "title",
        "text",
        "recommended_action",
        "similarity"
      ],
      "title": "ElogHit",
      "type": "object"
    },
    "GateDecision": {
      "properties": {
        "decision": {
          "enum": [
            "APPROVE",
            "APPROVE_SMALL_STEP",
            "REQUIRE_HUMAN_REVIEW",
            "REQUEST_CALIBRATION",
            "BLOCK"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "safe_next_step": {
          "title": "Safe Next Step",
          "type": "string"
        },
        "human_approval_required": {
          "title": "Human Approval Required",
          "type": "boolean"
        },
        "approved_delta_settings": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Approved Delta Settings",
          "type": "object"
        },
        "blocked_delta_settings": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Blocked Delta Settings",
          "type": "object"
        }
      },
      "required": [
        "decision",
        "reasons",
        "safe_next_step",
        "human_approval_required"
      ],
      "title": "GateDecision",
      "type": "object"
    },
    "MachineSettings": {
      "properties": {
        "quad_1": {
          "title": "Quad 1",
          "type": "number"
        },
        "quad_2": {
          "title": "Quad 2",
          "type": "number"
        },
        "steer_x": {
          "title": "Steer X",
          "type": "number"
        },
        "steer_y": {
          "title": "Steer Y",
          "type": "number"
        },
        "rf_phase": {
          "title": "Rf Phase",
          "type": "number"
        },
        "rf_amplitude": {
          "title": "Rf Amplitude",
          "type": "number"
        }
      },
      "required": [
        "quad_1",
        "quad_2",
        "steer_x",
        "steer_y",
        "rf_phase",
        "rf_amplitude"
      ],
      "title": "MachineSettings",
      "type": "object"
    },
    "ProposedAction": {
      "properties": {
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "delta_settings": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Delta Settings",
          "type": "object"
        },
        "source": {
          "default": "optimizer",
          "enum": [
            "human",
            "llm",
            "optimizer",
            "scenario"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "delta_settings"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "SafeSignals": {
      "properties": {
        "bpm_x_1": {
          "title": "Bpm X 1",
          "type": "number"
        },
        "bpm_y_1": {
          "title": "Bpm Y 1",
          "type": "number"
        },
        "bpm_x_2": {
          "title": "Bpm X 2",
          "type": "number"
        },
        "bpm_y_2": {
          "title": "Bpm Y 2",
          "type": "number"
        },
        "charge": {
          "title": "Charge",
          "type": "number"
        },
        "temperature": {
          "title": "Temperature",
          "type": "number"
        },
        "rf_readback": {
          "title": "Rf Readback",
          "type": "number"
        },
        "beam_current_proxy": {
          "title": "Beam Current Proxy",
          "type": "number"
        }
      },
      "required": [
        "bpm_x_1",
        "bpm_y_1",
        "bpm_x_2",
        "bpm_y_2",
        "charge",
        "temperature",
        "rf_readback",
        "beam_current_proxy"
      ],
      "title": "SafeSignals",
      "type": "object"
    },
    "VirtualDiagnosticResult": {
      "properties": {
        "predicted_quality": {
          "title": "Predicted Quality",
          "type": "number"
        },
        "predicted_size_x": {
          "title": "Predicted Size X",
          "type": "number"
        },
        "predicted_size_y": {
          "title": "Predicted Size Y",
          "type": "number"
        },
        "predicted_beam_loss": {
          "title": "Predicted Beam Loss",
          "type": "number"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "number"
        },
        "ood_score": {
          "title": "Ood Score",
          "type": "number"
        },
        "trust_state": {
          "enum": [
            "GREEN",
            "YELLOW",
            "RED"
          ],
          "title": "Trust State",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "predicted_quality",
        "predicted_size_x",
        "predicted_size_y",
        "predicted_beam_loss",
        "uncertainty",
        "ood_score",
        "trust_state",
        "reasons"
      ],
      "title": "VirtualDiagnosticResult",
      "type": "object"
    },
    "VisionDiagnosticResult": {
      "properties": {
        "centroid_x": {
          "title": "Centroid X",
          "type": "number"
        },
        "centroid_y": {
          "title": "Centroid Y",
          "type": "number"
        },
        "sigma_x": {
          "title": "Sigma X",
          "type": "number"
        },
        "sigma_y": {
          "title": "Sigma Y",
          "type": "number"
        },
        "ellipticity": {
          "title": "Ellipticity",
          "type": "number"
        },
        "halo_score": {
          "title": "Halo Score",
          "type": "number"
        },
        "clipping_score": {
          "title": "Clipping Score",
          "type": "number"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "centroid_x",
        "centroid_y",
        "sigma_x",
        "sigma_y",
        "ellipticity",
        "halo_score",
        "clipping_score",
        "labels"
      ],
      "title": "VisionDiagnosticResult",
      "type": "object"
    }
  },
  "properties": {
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "current_settings": {
      "$ref": "#/$defs/MachineSettings"
    },
    "safe_signals": {
      "$ref": "#/$defs/SafeSignals"
    },
    "proposed_action": {
      "$ref": "#/$defs/ProposedAction"
    },
    "virtual_diagnostic": {
      "$ref": "#/$defs/VirtualDiagnosticResult"
    },
    "vision_diagnostic": {
      "$ref": "#/$defs/VisionDiagnosticResult"
    },
    "elog_hits": {
      "items": {
        "$ref": "#/$defs/ElogHit"
      },
      "title": "Elog Hits",
      "type": "array"
    },
    "gate_decision": {
      "$ref": "#/$defs/GateDecision"
    },
    "simulated_outcome_if_applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/BeamTruth"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "scenario_id",
    "current_settings",
    "safe_signals",
    "proposed_action",
    "virtual_diagnostic",
    "vision_diagnostic",
    "elog_hits",
    "gate_decision"
  ],
  "title": "Ghost Beam DecisionRecord",
  "type": "object",
  "$id": "https://ghost-beam.local/schemas/decision_record.schema.json",
  "schema_version": "0.1.0",
  "description": "Machine-readable Ghost Beam gate decision over synthetic accelerator-control data."
}